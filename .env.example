# Publishing secrets. Copy this file to .env and fill it in — .env is git-ignored
# and excluded from the packaged .vsix, so the token never leaves this machine.
#
# Open VSX personal access token, used to publish releases of this extension.
# Create one at https://open-vsx.org/user-settings/tokens (namespace: omarkara).
# The publish tool reads this variable straight from the environment, so the token
# never has to be passed on the command line:
#
#   set -a; . ./.env; set +a
#   npx ovsx publish claude-status-chip-<version>.vsix
#
OVSX_PAT=

# Azure DevOps personal access token, used to publish to Microsoft's VS Code Marketplace.
# Create one at https://dev.azure.com -> user settings -> Personal access tokens, with
# Organization: "All accessible organizations" and scope Marketplace -> Manage. The publisher
# (omarkara) has to exist there first; publishers can only be created on the web.
#
#   set -a; . ./.env; set +a
#   npx @vscode/vsce publish --packagePath claude-status-chip-<version>.vsix
#
VSCE_PAT=
